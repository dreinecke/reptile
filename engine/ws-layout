def launcher_for(klass, ws):
    hit = LAUNCHERS_BY_WS.get(ws, {}).get(klass) or LAUNCHERS.get(klass)
    # A plain Chrome window on a desk with no per-desk override reopens on the Default
    # profile (2026-09-01, from the MacBook's first login replay: the Chrome windows on
    # ws4-6 had no launcher at all, so login skipped them). Chrome's own per-profile
    # session restore is what brings the tabs back; this only reopens the window.
    if not hit and klass == "google-chrome":
        return f"{ATTACH_DIR}/chrome-profile-window Default {ws}"
    return hit


def sh(cmd):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True).stdout


def dispatch(lua):
    """One Hyprland dispatch. ⚠️ Quattro parses the argument as LUA — the old
    `hyprctl dispatch movewindow 5` string form is a syntax error, not a no-op."""
    return subprocess.run(["hyprctl", "dispatch", lua], capture_output=True, text=True).stdout.strip()


def clients():
    return json.loads(sh("hyprctl clients -j") or "[]")


def active_ws():
    return json.loads(sh("hyprctl activeworkspace -j") or "{}").get("id", 1)


def on_ws(ws):
    return [c for c in clients() if c["workspace"]["id"] == ws]


def tiled_on(ws):
    return [c for c in on_ws(ws) if not c["floating"]]


def by_position(wins):
    return sorted(wins, key=lambda c: (c["at"][0], c["at"][1]))


def wait_until(cond, timeout, step=0.1):
    """Poll `cond` until it is true or `timeout` seconds pass. No fixed sleeps anywhere else: every
    wait in this file is for a specific thing to have happened, and moves on the moment it has."""
    t0 = time.monotonic()
    while True:
        if cond():
            return True
        if time.monotonic() - t0 > timeout:
            return False
        time.sleep(step)


def default_split_ratio():
    out = sh("hyprctl getoption dwindle:default_split_ratio")
    m = re.search(r"float:\s*([0-9.]+)", out)
    return float(m.group(1)) if m else 1.0


def set_default_split_ratio(ratio):
    """Dwindle gives the FIRST (left/top) side of every new split `ratio / 2` of the cell, so a
    share of 0.35 is a ratio of 0.7. ⚠️ `hyprctl keyword` refuses under Quattro's Lua config
    ("keyword can't work with non-legacy parsers. Use eval."); this is the form that works, and
    it changes nothing else in the dwindle table (checked 2026-09-03)."""
    ratio = max(0.1, min(1.9, ratio))
    sh(f"hyprctl eval 'hl.config({{ dwindle = {{ default_split_ratio = {ratio:.3f} }} }})'")


def snap_path(ws):
    return os.path.join(SNAP_DIR, f"ws{ws}.json")


def ws_name(ws):
    return next((w["name"] for w in json.loads(sh("hyprctl workspaces -j") or "[]")
                 if w["id"] == ws), str(ws))


