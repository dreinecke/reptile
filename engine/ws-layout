#!/usr/bin/env python3
"""ws-layout — snapshot a workspace's layout, and put a workspace back to it.

    ws-layout snapshot [ws]   record the workspace exactly as it looks now
    ws-layout restore  [ws]   make the workspace look like its recording again
    ws-layout columns  [n]    spread this workspace's tiled windows into equal side-by-side columns

Both default to the workspace Dave is on. Bound to HYPER+N and HYPER+R (see bindings.lua).

⚠️ THE RECORDING IS THE SPEC, AND THAT IS THE WHOLE POINT. `tile-windows.sh` carries one hand-written
function per desk, so a new window on a desk means editing a script. Here the desk itself is the
source: Dave arranges it however he likes, presses HYPER+N once, and HYPER+R restores that from then
on. The two live side by side — tile-windows.sh still runs at boot for the desks it knows.

⚠️ RESTORE CLOSES WINDOWS, so two rules are hard-coded rather than configurable:
  · an agent seat's terminal is NEVER closed (`NEVER_CLOSE`), because closing one leaves the seat
    running with nothing showing it — the exact fault fixed on 2026-08-11;
  · closing is `window.close`, which is a polite request the app can refuse, never a kill.
"""

import json
import os
import re
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
SNAP_DIR = os.path.join(HOME, ".config/omarchy/workspace-layout/snapshots")
ATTACH_DIR = os.path.join(HOME, ".config/omarchy/workspace-layout")

# Seats whose terminal must survive a restore even when it is not in the recording.
NEVER_CLOSE = {
    "claude-tinkerbell", "codex-tinkerbell",
    "claude-hazel", "codex-hazel",
    "claude-gandalf", "codex-gandalf",
