# ------------------------------------------------------------------ the tree
# A tree is a nested list: ["leaf", window] or [kind, left_or_top, right_or_bottom, share], kind
# "v" for side by side and "h" for stacked, share the fraction of the cell the left/top side has
# (None when it cannot be read). Lists rather than tuples so a leaf can be split in place.

def split_tree(rects):
    """Infer the guillotine tree behind a set of tiled rectangles.

    Every dwindle layout is a series of full-width or full-height cuts, so the tree can be read
    straight back off the geometry: find a vertical line no rectangle straddles (a column split),
    else a horizontal one (a row split), and recurse.
    """
    if len(rects) == 1:
        return ["leaf", rects[0]]

    for axis, kind in ((0, "v"), (1, "h")):
        edges = sorted({r["at"][axis] + r["size"][axis] for r in rects})
        for cut in edges[:-1]:
            a = [r for r in rects if r["at"][axis] + r["size"][axis] <= cut + 8]
            b = [r for r in rects if r["at"][axis] >= cut - 8]
            if a and b and len(a) + len(b) == len(rects):
                # The split line runs through the middle of the gap between the two sides; its
                # place along the cell is the share. Gaps at the cell's outer edges are ignored,
                # which is a few pixels on a 5K desk — proportions, not pixels, are the point.
                lo, hi = extent(rects, axis)
                mid = (max(r["at"][axis] + r["size"][axis] for r in a) + min(r["at"][axis] for r in b)) / 2
                share = (mid - lo) / (hi - lo) if hi > lo else None
                return [kind, split_tree(a), split_tree(b), share]

    # Not a clean guillotine (overlapping or a maximized window among the rest) — fall back to a
    # left-to-right row so the result is still usable rather than nothing.
    return ["v", ["leaf", rects[0]], split_tree(rects[1:]), None]


def extent(rects, axis):
    return (min(r["at"][axis] for r in rects), max(r["at"][axis] + r["size"][axis] for r in rects))


def first_leaf(node):
    return node[1] if node[0] == "leaf" else first_leaf(node[1])


def leaves(node):
    return [node[1]] if node[0] == "leaf" else leaves(node[1]) + leaves(node[2])


def steps_from_tree(tree):
    """The opening order that rebuilds `tree` under dwindle: the root's first window, then one step
    per split in pre-order — open the right/bottom side's first window beside the left/top side's
    first window. Pre-order is forced, not a choice: dwindle can only ever split ONE window's cell,
    so a window that sits beside a PAIR has to open before that pair is split.

    Each step is {"win": <window>, "after": <index of the window it splits, or None>, "side": r|d,
    "share": <fraction of the cell the left/top side keeps>, "node": <the split itself>}.
    """
    steps, index = [], {}

    def add(win, after, side, share=None, node=None):
        index[id(win)] = len(steps)
        steps.append({"win": win, "after": after, "side": side, "share": share, "node": node})

    add(first_leaf(tree), None, None)

    def walk(node):
        if node[0] == "leaf":
            return
        kind, a, b, share = node
        add(first_leaf(b), index[id(first_leaf(a))], "r" if kind == "v" else "d", share, node)
        walk(a)
        walk(b)

    walk(tree)
    return steps


def tree_from_steps(steps):
    """Replay an opening order on paper to get its tree back. `l` and `u` (a hand-edited recording)
    put the newcomer on the left/top; the tool itself only ever writes r and d."""
    if not steps:
        return None
    root = ["leaf", steps[0]["win"]]
    leaf_of = {0: root}
    for i, s in enumerate(steps[1:], 1):
        anchor = leaf_of[s["after"]]
        kind = "v" if s["side"] in ("r", "l") else "h"
        theirs, mine = ["leaf", anchor[1]], ["leaf", s["win"]]
        share = s.get("share")
        anchor[:] = [kind, theirs, mine, share] if s["side"] in ("r", "d") else [kind, mine, theirs, share]
        leaf_of[s["after"]] = theirs
        leaf_of[i] = mine
    return root


def prune(tree, keep):
    """Drop the leaves `keep` rejects; a split left with one side becomes that side."""
    if tree[0] == "leaf":
        return tree if keep(tree[1]) else None
    a, b = prune(tree[1], keep), prune(tree[2], keep)
    return [tree[0], a, b, tree[3]] if a and b else (a or b)


def steps_of(record):
    """A recording's opening order. Format 2 stores it; format 1 (before 2026-09-03, and every
    recording the MacBook still has) stored rectangles only, so the tree is read off those."""
    wins = record.get("windows", [])
    if not wins:
        return []
    if record.get("format", 1) >= 2 and all("side" in w for w in wins):
        return [{"win": w, "after": w["after"], "side": w["side"], "share": w.get("share"), "node": None}
                for w in wins]
    return steps_from_tree(split_tree(by_position(wins)))


def describe(steps):
    lines = []
    for i, s in enumerate(steps, 1):
        where = ""
        if s["after"] is not None:
            where = {"r": "right of", "l": "left of", "d": "below", "u": "above"}[s["side"]] + f" {s['after'] + 1}"
            if s.get("share") is not None:
                keeps = s["share"] if s["side"] in ("r", "d") else 1 - s["share"]
                where += f", which keeps {round(keeps * 100)}% of the {'width' if s['side'] in ('r', 'l') else 'height'}"
        lines.append(f"  {i}. {s['win']['class']}  {where}".rstrip())
    return "\n".join(lines)


# ---------------------------------------------------------------- snapshot

def take_snapshot(ws):
    wins = by_position(tiled_on(ws))
    # An empty desk is a layout too (Dave, 2026-09-02: saving it as empty "would be WAI") — the
    # recording says "nothing belongs here", and HYPER+R then closes whatever has wandered in.
    name = ws_name(ws)
    steps = steps_from_tree(split_tree(wins)) if wins else []
    record = {
        "workspace": ws,
        "name": name,
        "format": 2,
        # In opening order. `after` is the position (in this list) of the window each one is
        # opened beside, `side` which side of it, `share` the fraction of that cell the existing
        # side keeps. `at`/`size` are kept for reading, not restoring.
        "windows": [
            {
                "class": s["win"]["class"],
                "title": s["win"]["title"][:60],
                "launch": launcher_for(s["win"]["class"], ws),
                "after": s["after"],
                "side": s["side"],
                "share": round(s["share"], 3) if s["share"] is not None else None,
                "at": s["win"]["at"],
                "size": s["win"]["size"],
            }
            for s in steps
        ],
    }
    write_record(record)
    unknown = [w["class"] for w in record["windows"] if not w["launch"]]
    count = len(record["windows"])
    print(f"ws{ws} ({name}): recorded {count} windows → {snap_path(ws)}")
    if steps:
        print(describe(steps))
    if any(c.get("fullscreen") for c in wins) and count > 1:
        print("  ⚠️ a maximized window hides the arrangement; recorded left to right")
    if unknown:
        print("  ⚠️ no launch command known, so restore cannot re-open: " + ", ".join(unknown))
    if count == 0:
        body = "Recorded as empty. HYPER+R closes every window on this desk."
    else:
        body = f"{count} window{'s' if count != 1 else ''} recorded. HYPER+R puts the desk back to this."
    if unknown:
        body += " Cannot re-open if closed: " + ", ".join(unknown) + "."
    toast(f"Reptile saved workspace {ws} ({name})", body)
    return 0


def write_record(record):
    os.makedirs(SNAP_DIR, exist_ok=True)
    with open(snap_path(record["workspace"]), "w") as f:
        json.dump(record, f, indent=2)
        f.write("\n")


def record_from_steps(ws, name, steps):
    """A format-2 recording from an opening order (the panel's edits go through here)."""
    return {
        "workspace": ws,
        "name": name,
        "format": 2,
        "windows": [
            {
                "class": s["win"]["class"],
                "title": str(s["win"].get("title", ""))[:60],
                "launch": launcher_for(s["win"]["class"], ws),
                "after": s["after"],
                "side": s["side"],
                "share": round(s["share"], 3) if s.get("share") is not None else None,
                "at": s["win"].get("at"),
                "size": s["win"].get("size"),
            }
            for s in steps
        ],
    }


# ----------------------------------------------------------------- restore

def close_extras(ws, need):
    """Close what the recording does not list — never a seat. Floating strays (a dialog left
    behind) go first, then the oldest tiled copies; the newest of a class is the one kept."""
    have = {}
    for c in on_ws(ws):
        have.setdefault(c["class"], []).append(c)
    closing = []
    for klass, windows in have.items():
        if klass in NEVER_CLOSE:
            continue
        windows = [c for c in windows if c["floating"]] + [c for c in windows if not c["floating"]]
        for c in windows[: max(0, len(windows) - need.get(klass, 0))]:
            dispatch(f'hl.dsp.window.close({{ window = "address:{c["address"]}" }})')
            closing.append(c["address"])
    if closing:
        wait_until(lambda: not {c["address"] for c in clients()} & set(closing), 3.0)
    return len(closing)


def assign(steps, live):
    """Match each recorded window to one on the desk: same class and title first, then same class."""
    pool, assigned = list(by_position(live)), {}
    for exact in (True, False):
        for i, s in enumerate(steps):
            if i in assigned:
                continue
            w = s["win"]
            c = next((c for c in pool if c["class"] == w["class"]
                      and (not exact or c["title"][:60] == w.get("title", "")[:60])), None)
            if c:
                assigned[i] = c
                pool.remove(c)
    return assigned


def same_arrangement(live, steps, assigned):
    """Is the desk already arranged as the recording says? Compared by shape and by which class
    sits in each cell — never by size, and never by title (a Chrome title changes with the tab).
    A tiled window that is here but not in the recording (a seat kept by NEVER_CLOSE) is left out
    of the comparison: the recorded windows only have to be arranged right among themselves."""
    mine = {c["address"] for c in assigned.values()}
    if len(mine) != len(steps):
        return False
    # A maximized window reports the whole desk as its rectangle, so the tree cannot be read off
    # the geometry. The right windows are all here; leave them be rather than rebuild on a guess.
    if any(c.get("fullscreen") for c in live):
        return True
    now = steps_from_tree(prune(split_tree(by_position(live)), lambda c: c["address"] in mine))
    return [(s["win"]["class"], s["after"], s["side"]) for s in now] == \
           [(s["win"]["class"], s["after"], s["side"]) for s in steps]


def live_steps(live, assigned):
    """The desk as it is now, as an opening order over the recorded windows only."""
    mine = {c["address"] for c in assigned.values()}
    return steps_from_tree(prune(split_tree(by_position(live)), lambda c: c["address"] in mine))


def addressable_leaf(node):
    """A window whose nearest split along `node`'s axis IS `node`. Resizing a window moves the
    nearest split of that axis above it (dwindle's smart_resizing), so this is the window to
    resize to change this split — and a leaf on either side will do, since a positive delta
    always grows the left/top side. None when every path down crosses a same-axis split."""
    kind = node[0]

    def search(n):
        if n[0] == "leaf":
            return n[1]
        if n[0] == kind:
            return None
        return search(n[1]) or search(n[2])

    return search(node[1]) or search(node[2])


def size_gaps(live, steps, assigned):
    """Which splits are off the recording by more than the tolerance: (index, want, now)."""
    if any(c.get("fullscreen") for c in live):
        return []
    now = live_steps(live, assigned)
    gaps = []
    for i, (want, cur) in enumerate(zip(steps, now)):
        if want["after"] is None or want.get("share") is None or cur["share"] is None:
            continue
        if abs(want["share"] - cur["share"]) > SHARE_TOLERANCE:
            gaps.append((i, want["share"], cur["share"]))
    return gaps


def nudge_sizes(ws, steps, assigned):
    """Put each split that has drifted back to its recorded share with ONE resize — the same
    move SUPER+/- makes — outer splits first, re-reading the desk before each so the pixel
    delta is right after the previous one. Returns how many moved."""
    moved = 0
    for i, want, _ in size_gaps(tiled_on(ws), steps, assigned):
        live = tiled_on(ws)
        now = live_steps(live, assigned)
        if i >= len(now) or now[i]["share"] is None:
            continue
        node = now[i]["node"]
        leaf = addressable_leaf(node)
        if not leaf:
            continue
        axis = 0 if node[0] == "v" else 1
        lo, hi = extent(leaves(node), axis)
        delta = round((want - now[i]["share"]) * (hi - lo))
        if not delta:
            continue
        dispatch(f'hl.dsp.focus({{ window = "address:{leaf["address"]}" }})')
        dx, dy = (delta, 0) if axis == 0 else (0, delta)
        dispatch(f"hl.dsp.window.resize({{ x = {dx}, y = {dy}, relative = true }})")
        moved += 1
    return moved


def is_tiled(addr, ws):
    return any(c["address"] == addr and not c["floating"] for c in on_ws(ws))


def open_window(klass, cmd, ws):
    """Launch, then wait for the window it produces. Returns the client, or None on timeout."""
    before = {c["address"] for c in clients() if c["class"] == klass}
    subprocess.Popen(f"setsid {cmd} >/dev/null 2>&1 &", shell=True)
    found = []

    def mapped():
        for c in clients():
            if c["class"] == klass and c["address"] not in before and c.get("mapped", True):
                found.append(c)
                return True
        return False

    if not wait_until(mapped, OPEN_TIMEOUT):
        return None
    c = found[0]
    # A window rule can land it on another desk (its own), and Chrome can hand it over floating.
    if c["workspace"]["id"] != ws:
        dispatch(f'hl.dsp.window.move({{ workspace = "{ws}", follow = false, window = "address:{c["address"]}" }})')
    if c["floating"]:
        dispatch(f'hl.dsp.window.float({{ action = "disable", window = "address:{c["address"]}" }})')
    wait_until(lambda: is_tiled(c["address"], ws), 2.0)
    return c


def rebuild(ws, steps, assigned):
    """Walk the opening order. A window that is here is floated with the rest first and tiled back
    at its step; one that is missing is launched at its step and waited for. Either way dwindle
    places it beside the focused window on the preselected side, and it is never moved again.

    Returns (opened, failed, leftovers_retiled)."""
    present = tiled_on(ws)
    for c in present:
        dispatch(f'hl.dsp.window.float({{ action = "enable", window = "address:{c["address"]}" }})')
    if present:
        wait_until(lambda: not tiled_on(ws), 2.0)

    addr, opened, failed = {}, [], []
    usual_ratio = default_split_ratio()
    try:
        for i, s in enumerate(steps):
            klass = s["win"]["class"]
            if s["after"] is not None and s["after"] in addr:
                # The size is decided BEFORE the window exists: dwindle creates the split with
                # this ratio, so the window appears at its recorded share and never moves.
                share = s.get("share")
                set_default_split_ratio(2 * share if share is not None else usual_ratio)
                dispatch(f'hl.dsp.focus({{ window = "address:{addr[s["after"]]}" }})')
                dispatch(f'hl.dsp.layout("preselect {s["side"]}")')
            c = assigned.get(i)
            if c:
                dispatch(f'hl.dsp.window.float({{ action = "disable", window = "address:{c["address"]}" }})')
                wait_until(lambda: is_tiled(c["address"], ws), 2.0)
                addr[i] = c["address"]
                continue
            cmd = launcher_for(klass, ws) or s["win"].get("launch")
            c = open_window(klass, cmd, ws) if cmd else None
            if not c:
                failed.append(klass)
                # Disarm the preselect, or the next window Dave opens by hand would inherit it.
                dispatch('hl.dsp.layout("preselect x")')
                continue
            addr[i] = c["address"]
            opened.append(klass)

        # Whatever was tiled here and is in no step (a seat kept by NEVER_CLOSE) goes back into
        # the tree at the end rather than being left floating.
        set_default_split_ratio(usual_ratio)
        leftovers = [c for c in present if c["address"] not in addr.values()]
        for c in leftovers:
            dispatch(f'hl.dsp.window.float({{ action = "disable", window = "address:{c["address"]}" }})')
    finally:
        # Whatever happened, the next window Dave opens by hand gets dwindle's usual split.
        set_default_split_ratio(usual_ratio)
    return opened, failed, len(leftovers)


def stand_on(ws):
    """⚠️ STAND ON THE DESK BEFORE MOVING ANYTHING ON IT. A launched app with no window rule (Files
    is the one that matters) lands on whatever workspace is focused, dwindle splits the FOCUSED
    window, `preselect` applies to the desk that is up, and a resize acts on the active window.
    From HYPER+R this is true by definition; it is not for `ws-layout restore <n>` typed from
    elsewhere, nor for the login pass."""
    if active_ws() != ws:
        dispatch(f'hl.dsp.focus({{ workspace = "{ws}" }})')
        wait_until(lambda: active_ws() == ws, 2.0)


def restore(ws):
    path = snap_path(ws)
    if not os.path.exists(path):
        print(f"ws{ws}: no recording yet — press HYPER+S to make one")
        toast(f"Reptile has no recording of workspace {ws}", "Press HYPER+S on that desk first to record one.")
        return 1
    record = json.load(open(path))
    name = record.get("name", ws)
    steps = steps_of(record)

    # Everything up to the first thing that must MOVE is done from wherever Dave is standing:
    # closing works by address, and reading the desk is only `hyprctl clients`. The login pass
    # walks every recorded desk, and until 2026-09-03 it switched to each one first — an empty
    # recording, or a desk already as saved, still flashed past (Dave: "that feels like something
    # we can skip"). Now a desk is only shown when something on it has to open or move.

    # 1. Close anything the recording does not have — never a seat's terminal.
    need = Counter(s["win"]["class"] for s in steps)
    closed = close_extras(ws, need)

    if not steps:
        print(f"ws{ws} ({name}): empty desk restored" + (f", {closed} closed" if closed else ""))
        toast(f"Reptile restored workspace {ws} ({name})",
              (f"{closed} window{'s' if closed != 1 else ''} closed — " if closed else "") + "the desk is recorded as empty.")
        return 0

    # 2. Match the recording's windows to the desk's. A recorded window that is neither here nor
    #    openable (a plain terminal has no launch command) drops out of the plan for this run, and
    #    the tree closes over the gap — so a desk that holds everything it CAN hold counts as done.
    #    ⚠️ THE LIVE LAUNCHER WINS OVER THE RECORDED ONE. A recording stores the launch command as
    #    it stood the day it was taken, so changing LAUNCHERS here would otherwise do nothing to a
    #    desk already recorded (2026-08-20: the three admin sites kept coming back out of ws3.json).
    #    The stored string is only the fallback for a class no longer in the table at all.
    live = tiled_on(ws)
    assigned = assign(steps, live)
    unopenable = {id(s["win"]) for i, s in enumerate(steps)
                  if i not in assigned and not (launcher_for(s["win"]["class"], ws) or s["win"].get("launch"))}
    if unopenable:
        for s in steps:
            if id(s["win"]) in unopenable:
                print(f"  ⚠️ {s['win']['class']} is missing and there is no launch command for it")
        tree = prune(tree_from_steps(steps), lambda w: id(w) not in unopenable)
        if tree is None:
            print(f"ws{ws} ({name}): nothing in the recording is here or can be opened"
                  + (f", {closed} closed" if closed else ""))
            toast(f"Reptile: nothing to open on workspace {ws} ({name})",
                  "None of the recorded windows can be re-opened from here.")
            return 1
        steps = steps_from_tree(tree)
        assigned = assign(steps, live)

    # 3. Already arranged as recorded? Then nothing is rebuilt; a split dragged since the
    #    recording gets one resize back to its share, and everything else stays put.
    if len(assigned) == len(steps) and same_arrangement(live, steps, assigned):
        moved, focused = 0, None
        if size_gaps(live, steps, assigned):
            stand_on(ws)
            focused = json.loads(sh("hyprctl activewindow -j") or "{}").get("address")
            moved = nudge_sizes(ws, steps, assigned)
        if moved and focused and any(c["address"] == focused for c in on_ws(ws)):
            dispatch(f'hl.dsp.focus({{ window = "address:{focused}" }})')
        bits = ["already as saved"]
        if moved:
            bits.append(f"{moved} split{'s' if moved != 1 else ''} resized")
        if closed:
            bits.append(f"{closed} closed")
        print(f"ws{ws} ({name}): " + ", ".join(bits))
        toast(f"Reptile: workspace {ws} ({name}) is as saved",
              ((f"{moved} split{'s' if moved != 1 else ''} put back to size. " if moved else "")
               + (f"{closed} window{'s' if closed != 1 else ''} closed. " if closed else "")
               + ("" if moved or closed else "Nothing needed moving.")).strip())
        return 0

    # 4. Open and arrange in the recorded order, under the "Reptile is laying out…" card.
    desk = f"your {name} workspace" if isinstance(name, str) and name and name != str(ws) else f"workspace {ws}"
    laying_card(f"Reptile is laying out {desk}")
    try:
        stand_on(ws)
        opened, failed, leftovers = rebuild(ws, steps, assigned)
        # Chrome from cold can bring last session's windows with it — close those too.
        closed += close_extras(ws, need)
    finally:
        laid_card()

    placed = len(steps) - len(failed)
    bits = [f"{placed} window{'s' if placed != 1 else ''} in place"]
    if opened:
        bits.append(f"{len(opened)} opened")
    if closed:
        bits.append(f"{closed} closed")
    if failed:
        bits.append("could not open: " + ", ".join(failed))
    print(f"ws{ws} ({name}): " + ", ".join(bits))
    toast(f"Reptile restored workspace {ws} ({name})", ", ".join(bits) + ".")
    return 0 if not failed else 1


def show(ws):
    path = snap_path(ws)
    if not os.path.exists(path):
        print(f"ws{ws}: no recording")
        return 1
    record = json.load(open(path))
    steps = steps_of(record)
    fmt = record.get("format", 1)
    print(f"ws{ws} ({record.get('name', ws)}): {len(steps)} windows, opened in this order"
          + (" (old recording — order read off its rectangles)" if fmt < 2 else ""))
    print(describe(steps) if steps else "  (empty)")
    live = tiled_on(ws)
    assigned = assign(steps, live)
    missing = [s["win"]["class"] for i, s in enumerate(steps) if i not in assigned]
    extra = [c["class"] for c in on_ws(ws) if c["address"] not in {a["address"] for a in assigned.values()}]
    if not missing and not extra and same_arrangement(live, steps, assigned):
        off = size_gaps(live, steps, assigned)
        print("desk now: as saved" + (f", but {len(off)} split{'s' if len(off) != 1 else ''} off size: "
                                      + ", ".join(f"{i + 1}: {round(cur * 100)}% not {round(want * 100)}%" for i, want, cur in off)
                                      if off else ""))
    elif not missing and not extra:
        print("desk now: the same windows, arranged differently")
    else:
        print("desk now: differs"
              + (f"; missing: {', '.join(missing)}" if missing else "")
              + (f"; not in the recording (restore closes them): {', '.join(extra)}" if extra else ""))
    return 0


# ----------------------------------------------------------------- columns
# HYPER+3 is the one place that still lays a desk out to exact sizes: equal columns need every
# split nudged, which is exactly the rebuild restore gave up on 2026-09-03. It touches only what
# is already on the desk — nothing is opened or closed.

def build(node, addr_of):
    """Replay the tree with preselect: each step splits the ONE window currently filling a cell."""
    if node[0] == "leaf":
        return
    kind, a, b = node
    anchor = addr_of[id(first_leaf(a))]
    newcomer = addr_of[id(first_leaf(b))]
    dispatch(f'hl.dsp.focus({{ window = "address:{anchor}" }})')
    dispatch(f'hl.dsp.layout("preselect {"r" if kind == "v" else "d"}")')
    dispatch(f'hl.dsp.window.float({{ action = "disable", window = "address:{newcomer}" }})')
    time.sleep(0.25)
    build(a, addr_of)
    build(b, addr_of)


def live_size(addr, axis):
    for c in clients():
        if c["address"] == addr:
            return c["size"][axis]
    return None


def apply_ratios(node, addr_of):
    """Nudge each split to the asked-for proportions. Resize is a delta on the ACTIVE window, so
    focus the first leaf of the left/top side and push it to the width the rectangles ask for.
    ⚠️ EXACT, NOT "CLOSE ENOUGH": stopping within a dozen pixels once gave thirds of 836 / 834 /
    838, which Dave noticed. `columns` runs this twice because correcting an outer split changes
    what the splits inside it inherit."""
    if node[0] == "leaf":
        return
    kind, a, b = node
    leaf = first_leaf(a)
    axis = 0 if kind == "v" else 1
    a_rects = leaves(a)
    want = max(r["at"][axis] + r["size"][axis] for r in a_rects) - min(r["at"][axis] for r in a_rects)
    addr = addr_of[id(leaf)]
    cur = live_size(addr, axis)
    if cur is not None and abs(cur - want) > 0:
        dx, dy = (want - cur, 0) if axis == 0 else (0, want - cur)
        dispatch(f'hl.dsp.focus({{ window = "address:{addr}" }})')
        dispatch(f"hl.dsp.window.resize({{ x = {dx}, y = {dy}, relative = true }})")
        time.sleep(0.2)
    apply_ratios(a, addr_of)
    apply_ratios(b, addr_of)


def usable_area():
    """The rectangle a tiled window may occupy, derived rather than assumed.

    ⚠️ A WINDOW'S REPORTED POSITION INCLUDES ITS BORDER, which is why the outer margin reads as 12
    when `gaps_out` is 10 — and why hard-coding 12 would drift the day Dave changes either value.
    Between two windows there are two borders and two inner gaps, hence 14 from `gaps_in` of 5.
    Hyprland's `reserved` is [left, top, right, bottom]; the bar accounts for the 26 at the top.
    """
    def num(option):
        out = sh(f"hyprctl getoption {option}")
        nums = re.findall(r"-?\d+", out)
        return int(nums[0]) if nums else 0

    border = num("general:border_size")
    outer = num("general:gaps_out") + border
    inner = 2 * num("general:gaps_in") + 2 * border
    mon = json.loads(sh("hyprctl monitors -j") or "[]")[0]
    scale = mon.get("scale") or 1
    w, h = int(mon["width"] / scale), int(mon["height"] / scale)
    res = mon.get("reserved") or [0, 0, 0, 0]
    return (res[0] + outer, res[1] + outer, w - res[2] - outer, h - res[3] - outer, inner)


def columns(ws, want=None):
    """Side by side, equal shares — Dave's HYPER+3 for a desk of three."""
    wins = by_position(tiled_on(ws))
    if not wins:
        print(f"ws{ws}: nothing tiled here")
        return 1
    if want and len(wins) != want:
        print(f"ws{ws}: {len(wins)} tiled windows, not {want} — arranging the {len(wins)} that are here")
    n = len(wins)
    x0, y0, x1, y1, inner = usable_area()
    each = (x1 - x0 - inner * (n - 1)) // n
    rects, addr_of = [], {}
    for i, c in enumerate(wins):
        r = {"at": [x0 + i * (each + inner), y0], "size": [each, y1 - y0], "class": c["class"]}
        rects.append(r)
        addr_of[id(r)] = c["address"]
    dispatch(f'hl.dsp.focus({{ workspace = "{ws}" }})')
    wait_until(lambda: active_ws() == ws, 2.0)
    for c in on_ws(ws):
        dispatch(f'hl.dsp.window.float({{ action = "enable", window = "address:{c["address"]}" }})')
    wait_until(lambda: not tiled_on(ws), 2.0)
    tree = split_tree(rects)
    dispatch(f'hl.dsp.window.float({{ action = "disable", window = "address:{addr_of[id(first_leaf(tree))]}" }})')
    time.sleep(0.3)
    build(tree, addr_of)
    time.sleep(0.4)
    apply_ratios(tree, addr_of)
    apply_ratios(tree, addr_of)
    print(f"ws{ws}: {n} windows side by side, {each}px each")
    return 0


