def label_for(klass):
    if klass in LABELS:
        return LABELS[klass]
    m = re.match(r"chrome-([^_]+)__", klass)
    if m:
        host = m.group(1)
        if host in HOSTS:
            return HOSTS[host]
        parts = [p for p in host.split(".") if p not in ("www", "com", "net", "org", "ie", "app", "io", "ai")]
        return " ".join(w.capitalize() for w in parts) or host
    return klass


def unit_layout(tree):
    """Every window's rectangle inside the unit square, and every split line, drawn from the
    tree's shares — the picture the panel shows. Keyed by id() of the window / split node."""
    rects, lines = {}, {}

    def walk(node, x, y, w, h):
        if node[0] == "leaf":
            rects[id(node[1])] = (x, y, w, h)
            return
        kind, a, b, share = node
        s = share if share is not None else 0.5
        if kind == "v":
            lines[id(node)] = {"axis": "v", "pos": x + w * s, "cx": x, "cy": y, "cw": w, "ch": h}
            walk(a, x, y, w * s, h)
            walk(b, x + w * s, y, w * (1 - s), h)
        else:
            lines[id(node)] = {"axis": "h", "pos": y + h * s, "cx": x, "cy": y, "cw": w, "ch": h}
            walk(a, x, y, w, h * s)
            walk(b, x, y + h * s, w, h * (1 - s))

    if tree:
        walk(tree, 0.0, 0.0, 1.0, 1.0)
    return rects, lines


def desk_model(ws, name, all_clients):
    path = snap_path(ws)
    record = json.load(open(path)) if os.path.exists(path) else None
    steps = steps_of(record) if record else []
    tree = tree_from_steps(steps)
    if tree:
        steps = steps_from_tree(tree)      # so every split step carries its node
    rects, lines = unit_layout(tree)
    live = [c for c in all_clients if c["workspace"]["id"] == ws and not c["floating"]]
    assigned = assign(steps, live)
    windows, splits = [], []
    for i, s in enumerate(steps):
        x, y, w, h = rects[id(s["win"])]
        windows.append({
            "i": i, "class": s["win"]["class"], "label": label_for(s["win"]["class"]),
            "title": str(s["win"].get("title", "")), "after": s["after"], "side": s["side"],
            "share": s.get("share"), "open": i in assigned,
            "launchable": bool(launcher_for(s["win"]["class"], ws) or s["win"].get("launch")),
            "x": round(x, 4), "y": round(y, 4), "w": round(w, 4), "h": round(h, 4),
        })
        if s.get("node") is not None and id(s["node"]) in lines:
            ln = lines[id(s["node"])]
            splits.append(dict(ln, i=i, pos=round(ln["pos"], 4)))
    taken = {c["address"] for c in assigned.values()}
    extra = [{"class": c["class"], "label": label_for(c["class"]), "title": c["title"]}
             for c in by_position(live) if c["address"] not in taken and c["class"] not in NEVER_CLOSE]
    return {"ws": ws, "name": name, "recorded": record is not None, "windows": windows,
            "splits": splits, "extra": extra}


def desks_json():
    wss = sorted((w for w in json.loads(sh("hyprctl workspaces -j") or "[]") if w["id"] >= 1),
                 key=lambda w: w["id"])
    all_clients = clients()
    mon = (json.loads(sh("hyprctl monitors -j") or "[]") or [{}])[0]
    scale = mon.get("scale") or 1
    res = mon.get("reserved") or [0, 0, 0, 0]
    w = mon.get("width", 16) / scale - res[0] - res[2]
    h = mon.get("height", 9) / scale - res[1] - res[3]
    names = {w_["id"]: (w_["name"] if w_["name"] and w_["name"] != str(w_["id"]) else f"Desk {w_['id']}") for w_ in wss}
    # Recorded desks that Hyprland has forgotten (a persistent desk it dropped) still show.
    for f in os.listdir(SNAP_DIR) if os.path.isdir(SNAP_DIR) else []:
        m = re.match(r"ws(\d+)\.json$", f)
        if m and int(m.group(1)) not in names:
            names[int(m.group(1))] = json.load(open(os.path.join(SNAP_DIR, f))).get("name", m.group(1))
    apps = [{"class": k, "label": label_for(k)} for k in APP_ORDER]
    return {
        "active": active_ws(),
        "aspect": round(w / h, 4) if h else 1.78,
        "desks": [desk_model(n, names[n], all_clients) for n in sorted(names)],
        "apps": apps,
    }


def edit(ws, op, args):
    """One change to a desk's recording, then the whole model again for the panel to redraw."""
    path = snap_path(ws)
    record = json.load(open(path)) if os.path.exists(path) else None
    name = record.get("name") if record else ws_name(ws)
    steps = steps_of(record) if record else []
    tree = tree_from_steps(steps)
    steps = steps_from_tree(tree) if tree else []
    leaves_by_step = [s["win"] for s in steps]

    def leaf_node(i):
        return next(n for n in _leaf_nodes(tree) if n[1] is leaves_by_step[i])

    if op == "remove":
        i = int(args[0])
        tree = prune(tree, lambda w: w is not leaves_by_step[i]) if tree else None
    elif op == "add":
        klass = args[0]
        win = {"class": klass, "title": args[3] if len(args) > 3 else ""}
        if not tree:
            tree = ["leaf", win]
        else:
            after = int(args[1]) if len(args) > 1 and args[1] != "" else len(steps) - 1
            side = args[2] if len(args) > 2 and args[2] in ("r", "l", "d", "u") else "r"
            anchor = leaf_node(after)
            theirs, mine = ["leaf", anchor[1]], ["leaf", win]
            anchor[:] = ["v" if side in ("r", "l") else "h",
                         theirs if side in ("r", "d") else mine,
                         mine if side in ("r", "d") else theirs, 0.5]
    elif op == "swap":
        i, j = int(args[0]), int(args[1])
        a, b = leaf_node(i), leaf_node(j)
        a[1], b[1] = b[1], a[1]
    elif op == "share":
        i, value = int(args[0]), float(args[1])
        node = steps[i].get("node")
        if node is not None:
            node[3] = max(0.1, min(0.9, value))
    else:
        raise SystemExit(f"unknown edit: {op}")
    new_steps = steps_from_tree(tree) if tree else []
    write_record(record_from_steps(ws, name, new_steps))
    return 0


def _leaf_nodes(node):
    if node is None:
        return []
    return [node] if node[0] == "leaf" else _leaf_nodes(node[1]) + _leaf_nodes(node[2])


def main():
    global TOAST
    if "--quiet" in sys.argv:
        TOAST = False
        sys.argv = [a for a in sys.argv if a != "--quiet"]
    if len(sys.argv) < 2 or sys.argv[1] not in ("snapshot", "restore", "show", "columns", "desks", "edit"):
        print(__doc__)
        return 2
    if sys.argv[1] == "desks":
        print(json.dumps(desks_json()))
        return 0
    if sys.argv[1] == "edit":
        edit(int(sys.argv[2]), sys.argv[3], sys.argv[4:])
        print(json.dumps(desks_json()))
        return 0
    if sys.argv[1] == "columns":
        want = int(sys.argv[2]) if len(sys.argv) > 2 else None
        return columns(active_ws(), want)
    ws = int(sys.argv[2]) if len(sys.argv) > 2 else active_ws()
    return {"snapshot": take_snapshot, "restore": restore, "show": show}[sys.argv[1]](ws)


if __name__ == "__main__":
    sys.exit(main())
